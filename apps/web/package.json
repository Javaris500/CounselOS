{
  "name": "@counselos/web",
  "version": "0.1.0",
  "private": true,
  "description": "CounselOS frontend. Next.js App Router — two products, one deploy.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "msw:init": "msw init public/ --save",
    "clean": "rm -rf .next *.tsbuildinfo"
  },
  "dependencies": {
    "@counselos/shared": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "swr": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@counselos/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
