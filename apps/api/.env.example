# Copy to .env and fill. NEVER commit the filled version.
# Every variable is validated at boot by validateEnvVars() — a missing one
# fails the process immediately rather than three requests deep (00 §4).

# --- App ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# The client portal is the (client) route group inside apps/web — same deploy as
# the attorney app, so same port as FRONTEND_URL. Not the API port.
CLIENT_PORTAL_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# The single Phase-1 firm. Handled server-side; never accepted from a client.
FIRM_ID=

# --- Database ---
# Local (docker compose): ports come from the root .env, default 5432.
#   postgresql://counselos:counselos@localhost:5434/counselos?sslmode=disable
# Deployed: Supabase pooler URL, and ?sslmode=require is enforced.
DATABASE_URL=postgresql://counselos:counselos@localhost:5434/counselos?sslmode=disable

# --- Supabase (auth + storage; always hosted, no local equivalent) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Scoped to AuthService and StorageService only — never import it elsewhere.
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# --- Redis ---
# Local (docker compose): redis://localhost:6381
# Deployed: rediss:// — TLS is enforced outside development.
REDIS_URL=redis://localhost:6381

# --- Security (generate each with: openssl rand -base64 32) ---
JWT_SECRET=
# Signs client-portal tokens. Only the SHA-256 hash is ever stored.
HMAC_SECRET=

# --- Optional externals ---
# Leaving these blank is a supported state, not a broken one. The service
# reports `not_configured` through /v1/health/services and its feature renders
# a disabled state with a plain explanation — never a spinner that never
# resolves. Fill each one when you reach the slice that needs it:
#   slice 2 → VOYAGE   slice 3 → RESEND   slice 5 → ANTHROPIC
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENTRY_DSN=
