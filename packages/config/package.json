{
  "name": "@counselos/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsconfig, eslint, and prettier. No runtime code.",
  "type": "module",
  "files": [
    "tsconfig",
    "eslint",
    "prettier"
  ],
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./eslint/*": "./eslint/*.js",
    "./prettier": "./prettier/index.js"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
