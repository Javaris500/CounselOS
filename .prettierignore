# Prettier's default ignores are only node_modules and .git, and the root
# format script globs **/*.{ts,tsx,md,json,yml,yaml}. Without this file,
# `pnpm format` rewrites the pnpm lockfile and `pnpm format:check` fails in CI
# on files nobody hand-edits.

# Lockfile — reformatting it produces a spurious diff and can affect installs.
pnpm-lock.yaml

# Generated by drizzle-kit. Regenerated wholesale; never edited by hand.
apps/api/drizzle/

# Generated by Next.js on every build.
apps/web/next-env.d.ts

# Build output and caches (also covered by .gitignore, listed here because
# prettier does not read .gitignore).
dist/
build/
.next/
.turbo/
coverage/
