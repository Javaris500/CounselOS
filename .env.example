# Copy to .env before `docker compose up -d`. Read ONLY by docker-compose.yml,
# to pick the host ports for local Postgres and Redis.
#
# This is separate from apps/api/.env, which holds application config.
#
# Why not 5432/6379: those defaults collide with other Postgres and Redis
# instances people commonly already have running. Picking non-standard ports
# once, here, is cheaper than every developer debugging a connection that
# silently reached the wrong database. apps/api/.env.example points at these.
POSTGRES_PORT=5434
REDIS_PORT=6381
